{
  "expo": {
    "name": "كشف حساب",
    "slug": "patient-billing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#276a5e"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#276a5e",
        "foregroundImage": "./assets/icon.png",
        "backgroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png"
      },
      "package": "com.abulmagdation.patientbilling"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "17aa63b5-5b64-4b69-b3f3-c31467da44fd"
      }
    }
  }
}
